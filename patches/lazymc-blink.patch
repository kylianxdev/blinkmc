         }
+
+        // Quit once the process is gone, so a service manager can stop lazymc with one signal
+        while server.pid.lock().await.is_some() {
+            tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+        }
+        quit();
     }
 }
 
