[Unit]
Description=Minecraft Paper server (Blink: freezes when nobody plays, wakes up on join)
After=network-online.target bluemap-web.service
Wants=network-online.target bluemap-web.service

[Service]
User=minecraft
WorkingDirectory=/opt/minecraft
# tmux, so you can still type in the console: tmux attach -t minecraft
ExecStart=/usr/bin/tmux new-session -d -s minecraft /opt/lazymc/lazymc start -c /opt/minecraft/lazymc.toml
# SIGINT to lazymc itself: it thaws a frozen server, lets Paper save and stop, then quits (needs
# the patched lazymc). Ctrl+C in tmux does not work for this: Paper's console reads it in raw mode,
# and a frozen server reads nothing.
ExecStop=/bin/sh -c 'kill -INT $(pgrep -x lazymc) 2>/dev/null; true'
ExecStop=/bin/bash -c 'while tmux has-session -t minecraft 2>/dev/null; do sleep 1; done'
Type=forking
RemainAfterExit=yes
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
